# All secrets live in GitHub → Settings → Secrets and variables → Actions.
# The deploy workflow copies the function secrets into Supabase for you.
# This file is only a checklist; never commit real values.

# Used by the deploy workflow
SUPABASE_ACCESS_TOKEN=     # supabase.com → Account → Access Tokens
SUPABASE_DB_PASSWORD=      # set when you created the project (reset: Project Settings → Database)

# Copied into Supabase as Edge Function secrets
TRAVELPAYOUTS_TOKEN=       # travelpayouts.com → Tools → API
RESEND_API_KEY=            # resend.com → API Keys
ALERT_EMAIL_TO=            # where alerts go (must be your Resend account email until you verify a domain)
CRON_SECRET=               # any long random string; shared by GitHub Actions and the function
