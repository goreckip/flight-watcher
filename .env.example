# Configuration checklist. Nothing here is read from a file: everything is set in GitHub →
# Settings → Secrets and variables → Actions, and the deploy workflow passes it on.
# See SETUP.md for where to get each value. Never commit real values.

# --- Variables tab (not secret) ---
SUPABASE_PROJECT_REF=      # required: the id in https://<id>.supabase.co
TIMEZONE=                  # optional, default Europe/Warsaw
COUNTRY=                   # optional, default pl (Google Flights market)
DASHBOARD_URL=             # optional, default https://<owner>.github.io/<repo>/

# --- Secrets tab ---
SUPABASE_ACCESS_TOKEN=     # supabase.com → Account preferences → Access Tokens (sbp_…)
SUPABASE_DB_PASSWORD=      # set when creating the project
TRAVELPAYOUTS_TOKEN=       # travelpayouts.com → API token
SERPAPI_KEY=               # optional: serpapi.com → API key (Google Flights)
RESEND_API_KEY=            # resend.com → API Keys (re_…)
ALERT_EMAIL_TO=            # your Resend account email
APP_PASSWORD=              # dashboard password
CRON_SECRET=               # any long random string
